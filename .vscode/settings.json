{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "bootstrap": true,
        "config": true,
        "node_modules": true,
        "vendor": true,
        ".env.dusk.local": true,
        ".env.example": true,
        ".env.testing": true,
        "artisan": true,
        "composer.json": true,
        "composer.lock": true,
        "package-lock.json": true,
        "package.json": true,
        "phpunit.dusk.xml": true,
        "phpunit.xml": true,
        "logs": true,
        "silimium_tests": true,
        "tests": true,
        "stubs": true
    },
    "files.eol": "\n",
    "todo-tree.filtering.excludeGlobs": [
        "**/node_modules",
        "**/vendor",
        "**/10.gem-assistant.md"
    ],
    "todo-tree.filtering.includeHiddenFiles": true,
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "ai",
        "AI",
        "ia",
        "IA"
    ],
    "todo-tree.highlights.customHighlight": {
        "TODO": {
            "icon": "check",
            "foreground": "#ffcc00",
            "type": "text"
        },
        "FIXME": {
            "icon": "flame",
            "foreground": "#ff0000",
            "type": "text"
        },
        "ai": {
            "icon": "hubot",
            "foreground": "#d580ff",
            "type": "text",
            "gutterIcon": true
        },
        "AI": {
            "icon": "hubot",
            "foreground": "#d580ff",
            "type": "text",
            "gutterIcon": true
        },
        "ia": {
            "icon": "hubot",
            "foreground": "#d580ff",
            "type": "text",
            "gutterIcon": true
        },
        "IA": {
            "icon": "hubot",
            "foreground": "#d580ff",
            "type": "text",
            "gutterIcon": true
        }
    },
    "todo-tree.tree.showCountsInTree": true,
    "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)",
    "folder-color.pathColors": [],
    "hide-files.files": []
}